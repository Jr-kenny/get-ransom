# Frontend (safe to expose)
VITE_GITHUB_CLIENT_ID=
# Must match the GitHub OAuth App Redirect URI exactly
# (production: https://get-ransom.vercel.app — no trailing slash, no path)
VITE_GITHUB_REDIRECT_URI=

# Server only (Vercel env / never commit real values)
GITHUB_CLIENT_SECRET=
# HMAC secret for httpOnly session cookies (any long random string)
SESSION_SECRET=
# Upstash Redis REST (shared users + bounties)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=