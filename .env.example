# Frontend (safe to expose)
VITE_GITHUB_CLIENT_ID=
# Must match the GitHub OAuth App Authorization callback URL exactly
# (production: https://get-ransom.vercel.app — no trailing slash, no path)
VITE_GITHUB_REDIRECT_URI=
VITE_TREASURY_ADDRESS=NQ

# Server only (Vercel env / never commit real values)
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
